# Copy to .env.prod and replace EVERY placeholder before deployment.
# Plus simple : `python manage.py preparer_secrets_production` génère un
# fichier complet avec des secrets neufs (voir DEPLOIEMENT_SERVEUR.md).
SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
DEBUG=false

# Domaine de l'étude : Caddy obtient le certificat HTTPS automatiquement.
GED_DOMAIN=ged.example.com
GED_ACME_EMAIL=informatique@example.com
# Domaine EXACT (pas de joker, pas de tunnel temporaire) + localhost (sonde interne).
ALLOWED_HOSTS=ged.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://ged.example.com
# Frontal et API sur le même domaine : aucune origine croisée n'est nécessaire.
CORS_ALLOWED_ORIGINS=

# HTTPS obligatoire : la production REFUSE de démarrer si false.
SECURE_SSL_REDIRECT=true
# Essai local uniquement (http://localhost, sans certificat) : true lève les
# contrôles HTTPS/domaine. Jamais sur un serveur joignable depuis Internet.
GED_ALLOW_INSECURE_HTTP=false

# Limitation de débit : routes publiques (par adresse), utilisateur connecté (par compte).
THROTTLE_AUTH_RATE=20/minute
THROTTLE_USER_RATE=600/minute

POSTGRES_DB=ged_notaire
POSTGRES_USER=ged_user
POSTGRES_PASSWORD=GENERATE_A_STRONG_DB_PASSWORD

# 32-byte key encoded in URL-safe base64. Keep it in a secret manager and back it up separately.
DOCUMENT_ENCRYPTION_KEY=GENERATE_BASE64_32_BYTE_KEY

# Real SMTP: required in production for invitations and MFA. Tant que ces
# 3 valeurs restent vides, le backend refuse de démarrer si EMAIL_BACKEND
# reste sur smtp (voir prod.py) — c'est volontaire, pour ne jamais déployer
# silencieusement avec un SMTP qui ne marche pas. Pour un test local sans
# SMTP réel, repasser EMAIL_BACKEND à
# django.core.mail.backends.console.EmailBackend (le code apparaît alors
# dans `docker compose logs web`).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=GED Cabinet <no-reply@ged.example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# OCR
OCR_LANG=fra+eng
OCR_DPI=300
OCR_MAX_PAGES=50
DOCUMENT_MAX_UPLOAD_BYTES=26214400

# Optional S3-compatible off-site backup.
BACKUP_CLOUD_ENABLED=false
BACKUP_CLOUD_BUCKET=
BACKUP_CLOUD_PREFIX=ged
BACKUP_CLOUD_REGION=eu-west-1
BACKUP_CLOUD_ENDPOINT=
BACKUP_CLOUD_ACCESS_KEY=
BACKUP_CLOUD_SECRET_KEY=
BACKUP_INTERVAL_SECONDS=21600

# First deployment only: set true for one run, then set false again.
CREATE_INITIAL_ADMIN=false
INITIAL_ADMIN_EMAIL=notaire@example.com
INITIAL_ADMIN_PASSWORD=

# Google OAuth. Must match the provider configuration exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://ged.example.com/auth/oauth/google/callback
FRONTEND_OAUTH_LANDING_PATH=/login.html

WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180

# ---------------------------------------------------------------------------
# Automatisations (services « travaux » et « sauvegarde », run_worker)
# ---------------------------------------------------------------------------
# Doublure e-mail des notifications importantes (rappels J-7/J-3/J-1/jour J,
# retards, pièces manquantes, alertes). Envoyée depuis une file avec relances.
# Mettre false si aucun SMTP réel n'est configuré.
NOTIFICATIONS_EMAIL_ENABLED=true
# Paliers de rappel avant échéance (jours) et escalade au notaire (jours après).
TASK_REMINDER_DAYS=7,3,1
TASK_ESCALATION_DAYS=2
# OCR : pièces traitées par passage, tentatives, délai avant reprise d'un
# traitement bloqué (minutes).
OCR_BATCH=5
OCR_MAX_ATTEMPTS=3
OCR_STUCK_MINUTES=30
# Checklists : relance d'une pièce requise non reçue (jours après ouverture),
# préavis d'expiration d'une pièce datée, retour d'un original papier sorti.
CHECKLIST_REMINDER_DAYS=7
DOCUMENT_EXPIRY_NOTICE_DAYS=30
PHYSICAL_RETURN_DAYS=14
# Sauvegardes : fréquence, âge maximal toléré (0 = 2 × fréquence), rétention
# (toutes celles des 24 dernières heures + N quotidiennes/hebdomadaires/mensuelles).
BACKUP_INTERVAL_SECONDS=21600
BACKUP_MAX_AGE_HOURS=0
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# Exercice PRA hebdomadaire (0 = lundi … 6 = dimanche), à 04:00.
RESTORE_DRILL_WEEKDAY=6
# Surveillance de sécurité (fenêtre de 10 minutes) et heures d'ouverture.
SECURITY_MASS_VIEW_THRESHOLD=40
SECURITY_MASS_TRASH_THRESHOLD=5
SECURITY_FAILED_LOGIN_THRESHOLD=5
SECURITY_OFFICE_HOURS=07:00-20:00
# Rétention des notifications lues et de l'historique des travaux (jours).
NOTIFICATION_RETENTION_DAYS=180
JOBRUN_RETENTION_DAYS=90
# Un exécutant muet depuis ce délai (secondes) est signalé comme arrêté.
WORKER_STALE_SECONDS=180

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Nombre de proxies de confiance DEVANT l'application (nginx = 1).
NUM_PROXIES=1
# En-tête, posé par NOTRE nginx, qui porte l'adresse réelle du client. Il sert
# à la fois à la limitation de débit et à l'adresse inscrite au journal
# d'audit. X-Forwarded-For n'est JAMAIS lu : nginx y concatène ce que le
# navigateur envoie, la valeur est donc dictée par l'intéressé.
# Laisser vide UNIQUEMENT si l'application est exposée sans reverse proxy.
TRUSTED_CLIENT_IP_HEADER=HTTP_X_REAL_IP

# --- Durcissement ------------------------------------------------------------
# Antivirus des dépôts : fourni par le service `clamav` (déjà câblé pour `web`).
# La production refuse de démarrer sans antivirus, sauf ANTIVIRUS_DESACTIVE=true.
ANTIVIRUS_REQUIRED=true
# Surveillance externe (Healthchecks.io) : adresse de ping, vide = désactivée.
MONITORING_PING_URL=
MONITORING_PING_INTERVAL=300
# Admin Django et documentation de l'API : désactivés (ne pas exposer).
DJANGO_ADMIN_ENABLED=false
API_DOCS_ENABLED=false
