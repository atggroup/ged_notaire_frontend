DJANGO_SETTINGS_MODULE=ged_backend.settings.dev
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://ged_user:change-me@127.0.0.1:5432/ged_notaire
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
DOCUMENT_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Rotation des clés (facultatif) : renseignez ces deux variables lorsque
# vous programmez un changement de clé planifié. DOCUMENT_ENCRYPTION_KEYS
# est un objet JSON {key_id: clé_base64} pouvant contenir plusieurs
# générations ; DOCUMENT_ENCRYPTION_ACTIVE_KEY_ID indique laquelle chiffre
# les nouveaux documents. Ne retirez jamais une clé encore utilisée par un
# document existant (voir CONFORMITE_RGPD_ARTCI.md, section clés).
# Exemple : DOCUMENT_ENCRYPTION_KEYS={"2026-q1":"...","2026-q3":"..."}
# DOCUMENT_ENCRYPTION_KEYS=
# DOCUMENT_ENCRYPTION_ACTIVE_KEY_ID=2026-q3
# Laissez false tant qu'un prestataire de réplication hors site n'est pas réellement configuré.
BACKUP_CLOUD_ENABLED=false
# Sauvegarde locale indépendante (idéalement sur un volume différent de MEDIA_ROOT)
BACKUP_LOCAL_ROOT=./backup_store
# Stockage S3 ou compatible S3 pour la copie hors site
BACKUP_CLOUD_BUCKET=
BACKUP_CLOUD_PREFIX=ged
BACKUP_CLOUD_REGION=us-east-1
BACKUP_CLOUD_ENDPOINT=
BACKUP_CLOUD_ACCESS_KEY=
BACKUP_CLOUD_SECRET_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.invalid
# Pour un envoi réel des codes MFA et des invitations, passer EMAIL_BACKEND à
# django.core.mail.backends.smtp.EmailBackend et renseigner les variables
# ci-dessous (voir README_BACKEND.md, section « Email (SMTP réel) »).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# TLS (port 587) et SSL (port 465) sont exclusifs : n'activer qu'une seule des deux.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
INITIAL_ADMIN_EMAIL=notaire@example.com
# Optional: omit to generate and display a one-time password.
INITIAL_ADMIN_PASSWORD=

# Connexion "Continuer avec Google" (voir GOOGLE_OAUTH.md pour la marche à
# suivre pas-à-pas, sans jargon, pour créer ces identifiants).
GOOGLE_OAUTH_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=remplacez-moi
# Doit correspondre EXACTEMENT à l'URI de redirection autorisée déclarée
# dans Google Cloud Console (https://votre-domaine ou http://localhost:8000).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# OCR production/local requirements
OCR_LANG=fra+eng
OCR_DPI=300
OCR_MAX_PAGES=50
