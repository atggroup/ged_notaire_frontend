# Le projet tourne sous Linux (conteneurs Docker) : tout fichier texte est
# conservé en fins de ligne LF, même extrait sur un poste Windows.
# Un script .sh en CRLF empêche le conteneur de démarrer.
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires : jamais convertis.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.docx binary
*.xlsx binary
*.enc binary
